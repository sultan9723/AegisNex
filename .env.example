# AegisNex Environment Configuration
# Copy this file to .env and fill in your values.

# --- REQUIRED ---

# JWT secret for token signing. Generate with: openssl rand -hex 32
AEGISNEX_JWT_SECRET=change-this-to-a-random-256-bit-key

# Application environment: development | production | test
AEGISNEX_ENV=development

# --- DATABASE ---

# For production, use PostgreSQL:
# AEGISNEX_DATABASE_URL=postgresql://user:password@host:5432/aegisnex
# For development, SQLite is used by default (path in config.yaml)

# --- SMTP (Email Notifications) ---

# SMTP_HOST=localhost
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=aegisnex@example.com

# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# --- AUTH ---

# Token TTL in seconds (default: 1800 = 30 minutes)
# AEGISNEX_TOKEN_TTL_SECONDS=1800

# Refresh token TTL in seconds (default: 604800 = 7 days)
# AEGISNEX_REFRESH_TOKEN_TTL_SECONDS=604800

# Enterprise SSO via OIDC. Leave unset to hide the SSO button.
# Works with OIDC-compatible providers such as WorkOS, Auth0, Okta,
# Microsoft Entra ID, and Google Workspace.
# In production, SSO is required unless AEGISNEX_LOCAL_AUTH_ENABLED=true.
# AEGISNEX_SSO_PROVIDER_NAME=Enterprise SSO
# AEGISNEX_OIDC_ISSUER=https://your-provider.example.com
# AEGISNEX_OIDC_CLIENT_ID=your-client-id
# AEGISNEX_OIDC_CLIENT_SECRET=your-client-secret
# AEGISNEX_OIDC_REDIRECT_URI=https://api.example.com/api/auth/sso/callback
# AEGISNEX_OIDC_SCOPES=openid email profile
# AEGISNEX_OIDC_DEFAULT_ROLE=read_only
# AEGISNEX_SSO_ALLOWED_DOMAINS=example.com
# Comma-separated emails that receive super_admin on SSO login.
# AEGISNEX_BOOTSTRAP_ADMIN_EMAILS=admin@example.com
# Production defaults to requiring every non-super-admin user to belong to an org.
# AEGISNEX_REQUIRE_TENANT_MEMBERSHIP=true
# Optional self-serve mode: create/assign orgs based on SSO email domain.
# Keep false for strict enterprise deployments with manual/admin provisioning.
# AEGISNEX_SSO_AUTO_CREATE_ORGS=false

# Local password auth is enabled by default only outside production.
# AEGISNEX_LOCAL_AUTH_ENABLED=false

# Demo auth and seeded admin are enabled by default only outside production.
# AEGISNEX_DEMO_AUTH_ENABLED=false
# AEGISNEX_SEED_DEFAULT_ADMIN=false

# --- CORS ---

# Comma-separated list of allowed CORS origins for production
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# --- METRICS ---

# Token to protect the /metrics endpoint (recommended for production)
# AEGISNEX_METRICS_TOKEN=change-this-to-a-random-token

# --- MONITORING ---

# WebSocket poll interval in seconds (default: 5.0)
# AEGISNEX_WS_POLL_INTERVAL_SECONDS=5.0

# Monitoring engine interval in seconds (default: 30)
# AEGISNEX_MONITOR_INTERVAL_SECONDS=30

# --- LOGGING ---

# Log level: DEBUG | INFO | WARNING | ERROR (default: INFO)
# LOG_LEVEL=INFO
