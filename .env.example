# AegisNex Environment Configuration
# Copy this file to .env and fill in your values.

# --- REQUIRED ---

# JWT secret for token signing. Generate with: openssl rand -hex 32
AEGISNEX_JWT_SECRET=change-this-to-a-random-256-bit-key

# Application environment: development | production | test
AEGISNEX_ENV=development

# Force the app to redirect HTTP -> HTTPS itself. Leave unset/false when
# deployed behind a TLS-terminating managed proxy (e.g. Back4app, Azure
# Container Apps ingress) - the proxy already serves HTTPS and forwards
# requests to the container over HTTP, so a forced redirect here would loop.
# Only set to true for deployments where the app itself must terminate TLS
# redirects (no proxy in front handling HTTPS).
# AEGISNEX_FORCE_HTTPS_REDIRECT=false

# Enable Docker container monitoring/remediation (Guardian, self-healing,
# container metrics). Defaults to true for local development, where a
# Docker daemon is normally reachable. Managed container hosts (e.g.
# Back4app) do not expose /var/run/docker.sock - set this to false there to
# stop the scanner from repeatedly failing to connect to a Docker daemon
# that will never be present. HTTP/TCP/SSL monitoring, the database, auth,
# incidents, and governance are unaffected either way.
# AEGISNEX_DOCKER_SCANNER_ENABLED=true

# --- AZURE CONTAINER APPS ---

# Public frontend origin used for backend auth redirects after login/logout/SSO.
# Set to the frontend Container App HTTPS URL.
# AEGISNEX_FRONTEND_URL=https://your-frontend-app.example.com

# Optional external observability endpoints. Leave unset unless deployed.
# AEGISNEX_GRAFANA_URL=https://your-grafana.example.com
# AEGISNEX_PROMETHEUS_URL=https://your-prometheus.example.com

# --- DATABASE ---

# For production, use PostgreSQL. AEGISNEX_DATABASE_URL and the plain
# DATABASE_URL are both read; if both are set, AEGISNEX_DATABASE_URL wins.
# AEGISNEX_DATABASE_URL=postgresql://user:password@host:5432/aegisnex
# For development, SQLite is used by default (path in config.yaml)

# --- SECRETS AT REST (optional) ---

# Encryption key for the secrets-management feature (Fernet symmetric
# encryption of stored integration credentials). NOT required to boot the
# app - only needed if/when a secrets-management endpoint is used. Distinct
# from AEGISNEX_JWT_SECRET (which signs login sessions, above).
# Must decode to exactly 32 bytes. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AEGISNEX_SECRET_KEY=

# --- SMTP (Email Notifications) ---

# SMTP_HOST=localhost
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# --- AUTH ---

# Token TTL in seconds (default: 1800 = 30 minutes)
# AEGISNEX_TOKEN_TTL_SECONDS=1800

# Refresh token TTL in seconds (default: 604800 = 7 days)
# AEGISNEX_REFRESH_TOKEN_TTL_SECONDS=604800

# Enterprise SSO via OIDC. Leave unset to hide the SSO button.
# Works with OIDC-compatible providers such as WorkOS, Auth0, Okta,
# Microsoft Entra ID, and Google Workspace.
# In production, SSO is required unless AEGISNEX_LOCAL_AUTH_ENABLED=true.
# AEGISNEX_SSO_PROVIDER_NAME=Enterprise SSO
# AEGISNEX_OIDC_ISSUER=https://your-provider.example.com
# AEGISNEX_OIDC_CLIENT_ID=your-client-id
# AEGISNEX_OIDC_CLIENT_SECRET=your-client-secret
# AEGISNEX_OIDC_REDIRECT_URI=https://api.example.com/api/auth/sso/callback
# AEGISNEX_OIDC_SCOPES=openid email profile
# AEGISNEX_OIDC_DEFAULT_ROLE=read_only
# AEGISNEX_SSO_ALLOWED_DOMAINS=example.com
# Comma-separated emails that receive super_admin on SSO login.
# AEGISNEX_BOOTSTRAP_ADMIN_EMAILS=admin@example.com
# Production defaults to requiring every non-super-admin user to belong to an org.
# AEGISNEX_REQUIRE_TENANT_MEMBERSHIP=true
# Optional self-serve mode: create/assign orgs based on SSO email domain.
# Keep false for strict enterprise deployments with manual/admin provisioning.
# AEGISNEX_SSO_AUTO_CREATE_ORGS=false

# Local password auth is enabled by default only outside production.
# AEGISNEX_LOCAL_AUTH_ENABLED=false

# Seeded admin is enabled by default only outside production.
# AEGISNEX_SEED_DEFAULT_ADMIN=false
# Password for the seeded "admin" account. Required if AEGISNEX_SEED_DEFAULT_ADMIN=true
# (in production it must also be paired with AEGISNEX_LOCAL_AUTH_ENABLED=true, since
# SSO is otherwise required). Generate with: openssl rand -base64 24
# AEGISNEX_BOOTSTRAP_ADMIN_PASSWORD=

# "Try Demo Workspace" one-click login. Disabled by default in every
# environment, including production - must be explicitly opted in. Issues a
# normal short-lived session for a dedicated, restricted read_only account
# (never the real admin, never any of super_admin/administrator/operator).
# Safe to enable in production for a recruiter-facing demo deployment.
# AEGISNEX_DEMO_ENABLED=false
# Legacy alias accepted for existing deployments: AEGISNEX_DEMO_AUTH_ENABLED=false
# Server-side-only secret used to authenticate the demo account internally.
# The browser never sees this value. Generate with: python scripts/generate_secrets.py
# AEGISNEX_DEMO_PASSWORD=
# Login/email for the demo account (default: demo)
# AEGISNEX_DEMO_USERNAME=demo

# --- CORS ---

# Comma-separated list of allowed CORS origins. Required when the frontend is
# hosted on a different origin than the backend (e.g. a separately deployed
# Next.js app). In production with this unset, CORS origins default to an
# empty list (all cross-origin browser requests blocked) - not localhost.
# AEGISNEX_CORS_ORIGINS=https://app.example.com,https://admin.example.com

# --- METRICS ---

# Token to protect the /metrics endpoint (recommended for production)
# AEGISNEX_METRICS_TOKEN=change-this-to-a-random-token

# --- MONITORING ---

# WebSocket poll interval in seconds (default: 5.0)
# AEGISNEX_WS_POLL_INTERVAL_SECONDS=5.0

# Monitoring engine interval in seconds (default: 30)
# AEGISNEX_MONITOR_INTERVAL_SECONDS=30

# --- LOGGING ---

# Log level: DEBUG | INFO | WARNING | ERROR (default: INFO)
# AEGISNEX_LOG_LEVEL=INFO


# --- FRONTEND CONTAINER APP ---

# Backend HTTPS origin. Do not include a trailing /api; the frontend normalizes it.
# Leave UNSET for a same-origin deployment (e.g. behind Cloudflare Tunnel,
# see docs/CLOUDFLARE_TUNNEL_DEPLOYMENT.md) - the frontend then issues
# relative /api and /ws requests against its own origin instead of baking
# a separate backend URL into the browser bundle, and BACKEND_INTERNAL_URL
# below tells the frontend server where to proxy those to internally.
# NEXT_PUBLIC_API_URL=https://your-backend-app.example.com

# Backend secure WebSocket origin for dashboard live updates. Same
# same-origin note as NEXT_PUBLIC_API_URL above - leave unset together with it.
# NEXT_PUBLIC_WS_URL=wss://your-backend-app.example.com

# --- SAME-ORIGIN DEPLOYMENT (frontend proxies /api/* and /ws/* to FastAPI) ---

# Server-only backend origin the Next.js server proxies to (see
# frontend/next.config.js rewrites()). Deliberately NOT prefixed
# NEXT_PUBLIC_ so Next never inlines it into the browser bundle - only the
# frontend server ever reads this. In docker-compose.production.yml this is
# the Docker-internal backend service, e.g. http://backend:8000.
# BACKEND_INTERNAL_URL=http://backend:8000

# Cloudflare Tunnel token (Zero Trust dashboard -> Networks -> Tunnels ->
# your tunnel -> Docker install command). Used only by the cloudflared
# service in docker-compose.production.yml.
# CLOUDFLARE_TUNNEL_TOKEN=
