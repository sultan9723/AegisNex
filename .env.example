# Copy this file to .env and fill in real values.
# .env is ignored by git.

SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TIMEOUT_SECONDS=10
SMTP_STARTTLS=true

# Backward-compatible names EMAIL_USER, EMAIL_PASS, and EMAIL_TO are also supported.
SMTP_USERNAME=youraddress@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_RECIPIENT=recipient@example.com
SMTP_SUBJECT=AegisNex Alert

# Incident notification providers
NOTIFY_EMAIL_HOST=smtp.gmail.com
NOTIFY_EMAIL_PORT=587
NOTIFY_EMAIL_STARTTLS=true
NOTIFY_EMAIL_USERNAME=youraddress@gmail.com
NOTIFY_EMAIL_PASSWORD=your_app_password
NOTIFY_EMAIL_SENDER=youraddress@gmail.com
NOTIFY_EMAIL_RECIPIENT=recipient@example.com
NOTIFY_EMAIL_SUBJECT=AegisNex Incident
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Dashboard authentication
AEGISNEX_JWT_SECRET=replace_with_a_long_random_secret
